RewriteEngine On

# API — diteruskan lewat api-proxy.php (bekerja tanpa mod_proxy di shared hosting)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(/?)(.*)$ api-proxy.php [L,QSA]

# Uploads (logo & foto produk) — diteruskan lewat api-proxy.php ke backend Go di 127.0.0.1:8080
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads(/.*)?$ api-proxy.php [L,QSA]

# Biarkan file statis dilayani langsung
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]