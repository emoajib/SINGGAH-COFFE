# PHP settings – increase limits for large file uploads + long requests
php_value memory_limit 512M
php_value max_execution_time 600
php_value post_max_size 16M
php_value upload_max_filesize 16M

RewriteEngine On

# Service worker & manifest – DISABLE cache (force update)
<Files "sw.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
<Files "registerSW.js">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>
<Files "manifest.webmanifest">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
</Files>

# API – diteruskan lewat api-proxy.php (bekerja tanpa mod_proxy di shared hosting)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^api(/?)(.*)$ api-proxy.php [L,QSA]

# Uploads (logo & foto produk) – diteruskan lewat api-proxy.php ke backend Go di 127.0.0.1:8080
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^uploads(/.*)?$ api-proxy.php [L,QSA]

# Biarkan file statis dilayani langsung
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ /index.html [L]